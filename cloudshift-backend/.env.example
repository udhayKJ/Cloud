# ===================================================
# CloudShift AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ===================================================

# ===== Active Spring Profile =====
# Use 'dev' for local H2 in-memory DB (no AWS needed)
# Use 'prod' for AWS RDS + real AWS service calls
SPRING_PROFILES_ACTIVE=dev

# ===== Database (required only for prod profile) =====
DB_URL=jdbc:postgresql://<RDS-ENDPOINT>:5432/cloudshiftdb
DB_USER=cloudshift_admin
DB_PASSWORD=<YOUR_STRONG_PASSWORD>

# ===== JWT =====
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=replace-this-with-a-strong-secret-key-minimum-32-chars
JWT_EXPIRATION_MS=86400000

# ===== AWS (required only for prod profile) =====
AWS_REGION=us-east-1
S3_BUCKET_NAME=cloudshift-reports-<your-account-id>
DYNAMODB_TABLE=cloudshift-simulation-events
BEDROCK_MODEL_ID=anthropic.claude-haiku-20240307-v1:0

# AWS credentials — NOT needed when running on EC2 with an instance role
# Only set these for local dev against real AWS services
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
